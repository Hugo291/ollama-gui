import { Button, ScrollView, ListView, Spinner, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Api, ModelRow } from "api.slint";
import {
    Icon, Label, ModelIcon, Badge, CapabilityBadge, CapabilityIcons, StatusDot, ToolButton, SearchField,
    EmptyState, CodeDisclosure, Divider, VDivider, Toolbar, MenuButton, MenuEntry, Splitter, DangerButton
} from "components.slint";

export global ModelFilters {
    public pure function title(filter: int) -> string {
        if filter == 1 { return @tr("Local"); }
        if filter == 2 { return @tr("Cloud"); }
        if filter == 3 { return @tr("Vision"); }
        if filter == 4 { return @tr("Tools"); }
        if filter == 5 { return @tr("Thinking"); }
        if filter == 6 { return @tr("Embedding"); }
        if filter == 7 { return @tr("Image"); }
        return @tr("All Models");
    }
}

component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <int> column: -1;
    property <bool> sorted: column >= 0 && Api.sort-column == column;
    accessible-role: button;
    accessible-enabled: root.column >= 0;
    accessible-label: root.title;
    accessible-action-default => { root.sort(); }
    background: touch.has-hover && column >= 0 ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: Theme.small-font-size;
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.sorted: Icon {
            icon: Api.sort-ascending ? Icons.chevron-up : Icons.chevron-down;
            size: 11px;
            tint: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }
    }
    touch := TouchArea {
        enabled: root.column >= 0;
        clicked => { root.sort(); }
    }

    function sort() {
        if root.column < 0 {
            return;
        }
        if Api.sort-column == root.column {
            Api.sort-ascending = !Api.sort-ascending;
        } else {
            Api.sort-column = root.column;
            Api.sort-ascending = root.column == 0;
        }
        Api.models-query-changed();
    }
}

component Cell inherits Rectangle {
    in property <string> text;
    in property <bool> secondary;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: root.secondary ? Theme.text-secondary : Theme.text;
        font-size: Theme.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ModelTableRow inherits Rectangle {
    in property <ModelRow> data;
    in property <int> index;
    in property <bool> compact;
    property <bool> selected: data.selected;
    // Among several selected models: the menu acts on all of them.
    property <bool> multi: data.selected && Api.selected-count > 1;
    // Shift extends the selection, ⌘ (Ctrl on Windows) adds or removes this model.
    callback clicked(extend: bool, toggle: bool);
    accessible-role: list-item;
    accessible-label: root.data.name;
    accessible-description: root.data.parameters + " " + root.data.size;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
    accessible-action-default => { root.clicked(false, false); }
    height: 32px;
    background: selected ? Theme.selection : touch.has-hover ? Theme.hover : Math.mod(index, 2) == 1 ? Theme.zebra : transparent;
    ContextMenuArea {
        Menu {
            if !root.multi: MenuItem {
                title: @tr("Chat");
                enabled: root.data.can-chat;
                activated => { Api.chat-with(root.data.name); }
            }
            if !root.multi && root.data.running: MenuItem {
                title: @tr("Unload from Memory");
                activated => { Api.unload-model(root.data.name); }
            }
            if !root.multi && !root.data.running: MenuItem {
                title: @tr("Load into Memory");
                enabled: root.data.can-load;
                activated => { Api.load-model(root.data.name); }
            }
            if !root.multi: MenuSeparator { }
            if !root.multi: MenuItem {
                title: @tr("Update");
                activated => { Api.update-model(root.data.name); }
            }
            if !root.multi: MenuItem {
                title: @tr("Duplicate…");
                activated => { Api.open-dialog(2, root.data.name); }
            }
            if !root.multi: MenuItem {
                title: @tr("Rename…");
                activated => { Api.open-dialog(3, root.data.name); }
            }
            if !root.multi: MenuItem {
                title: @tr("Customize…");
                enabled: root.data.can-customize;
                activated => { Api.open-dialog(4, root.data.name); }
            }
            if !root.multi: MenuSeparator { }
            if !root.multi: MenuItem {
                title: @tr("Copy Name");
                activated => { Api.copy-name(root.data.name); }
            }
            if !root.multi: MenuItem {
                title: @tr("Open Model Page");
                enabled: root.data.has-page;
                activated => { Api.open-page(root.data.name); }
            }
            if !root.multi: MenuSeparator { }
            if !root.multi: MenuItem {
                title: @tr("Delete…");
                activated => { Api.open-dialog(5, root.data.name); }
            }
            // Several models: the actions of version 1 for a selection.
            if root.multi: MenuItem {
                title: Api.selection-update-label;
                enabled: Api.selection-can-update;
                activated => { Api.update-selection(); }
            }
            if root.multi && Api.selection-has-running: MenuItem {
                title: @tr("Unload from Memory");
                activated => { Api.unload-selection(); }
            }
            if root.multi: MenuSeparator { }
            if root.multi: MenuItem {
                title: Api.selection-delete-label;
                activated => { Api.delete-selection(); }
            }
        }
        touch := TouchArea {
            pointer-event(event) => {
                if event.kind != PointerEventKind.down {
                    return;
                }
                if event.button == PointerEventButton.left {
                    root.clicked(event.modifiers.shift, event.modifiers.control);
                } else if event.button == PointerEventButton.right && !root.data.selected {
                    // Right-click outside the selection selects that model, before its menu opens.
                    root.clicked(false, false);
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        Rectangle {
            horizontal-stretch: 1;
            min-width: 128px;
            HorizontalLayout {
                spacing: 8px;
                ModelIcon {
                    kind: root.data.kind;
                    size: 20px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.data.name;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    max-width: self.preferred-width;
                }
                if root.data.running: StatusDot {
                    dot-color: Theme.green;
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    Tooltip { text: @markdown("\{@tr("Loaded in memory")}"); }
                }
                if root.data.downloading: Spinner {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    indeterminate: root.data.progress < 0;
                    progress: max(root.data.progress, 0);
                }
                if !root.data.downloading && root.data.update == 2: Icon {
                    icon: Icons.downloads;
                    tint: Theme.accent;
                    size: 14px;
                    y: (parent.height - self.height) / 2;
                    Tooltip { text: @markdown("\{@tr("Update available")}"); }
                }
                if !root.data.downloading && root.data.update == 1: Spinner {
                    width: 12px;
                    height: 12px;
                    indeterminate: true;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle { horizontal-stretch: 0.001; }
            }
        }
        Cell { width: Api.column-parameters; text: root.data.parameters; }
        if !root.compact: Cell { width: Api.column-quantization; text: root.data.quantization; }
        Cell { width: Api.column-size; text: root.data.size; secondary: root.data.is-cloud; }
        Rectangle {
            width: Api.column-capabilities;
            clip: true;
            CapabilityIcons {
                x: 8px;
                capabilities: root.data.capabilities;
            }
        }
        if !root.compact: Cell {
            width: Api.column-modified;
            text: root.data.modified;
            secondary: true;
            Tooltip { text: @markdown("\{root.data.modified-long}"); }
        }
    }
}

component ModelTable inherits Rectangle {
    // Rows are 4 px narrower than the table: the Cupertino list keeps 2 px on each side.
    property <length> row-width: self.width - 4px;
    // Without room for every column (Name keeps 140 px with its icon), Quantization and Modified are hidden.
    property <bool> compact: root.row-width < 140px + Api.column-parameters + Api.column-quantization + Api.column-size + Api.column-capabilities + Api.column-modified;
    // What Name has beyond its minimum: a column grows by this much at most, so a drag
    // neither squeezes Name nor switches the table to compact under the pointer. Negative
    // in a very narrow window: the columns can then only shrink.
    property <length> room: root.row-width - 140px - Api.column-parameters - Api.column-size - Api.column-capabilities
        - (root.compact ? 0px : Api.column-quantization + Api.column-modified);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: Theme.card;
    clip: true;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            // Delete, or ⌘⌫ on macOS (Slint reports ⌘ as `control`) and Ctrl+Backspace on Windows.
            if event.text == Key.Delete || (event.text == Key.Backspace && event.modifiers.control) {
                if Api.selected-count > 1 {
                    Api.delete-selection();
                    return accept;
                }
                if Api.selected-model != "" {
                    Api.open-dialog(5, Api.selected-model);
                    return accept;
                }
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                Api.move-selection(event.text == Key.UpArrow ? -1 : 1, event.modifiers.shift);
                return accept;
            }
            if (event.text == "a" || event.text == "A") && event.modifiers.control {
                Api.select-all-models();
                return accept;
            }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: 30px;
                HorizontalLayout {
                    padding-left: 40px;
                    HeaderCell { title: @tr("Name"); column: 0; horizontal-stretch: 1; min-width: 100px; }
                    HeaderCell { title: @tr("Parameters"); column: 1; width: Api.column-parameters; }
                    if !root.compact: HeaderCell { title: @tr("Quantization"); column: 2; width: Api.column-quantization; }
                    HeaderCell { title: @tr("Size"); column: 3; width: Api.column-size; }
                    HeaderCell { title: @tr("Capabilities"); width: Api.column-capabilities; }
                    if !root.compact: HeaderCell { title: @tr("Modified"); column: 4; width: Api.column-modified; }
                }
                // Column edges: dragging the left edge of a column resizes it, Name takes the rest.
                property <length> modified-width: root.compact ? 0px : Api.column-modified;
                property <length> quantization-width: root.compact ? 0px : Api.column-quantization;
                if !root.compact: Splitter {
                    x: parent.width - Api.column-modified - 3px;
                    height: parent.height;
                    show-line: true;
                    reversed: true;
                    size <=> Api.column-modified;
                    minimum: 70px;
                    maximum: min(220px, Api.column-modified + max(root.room, 0px));
                    default-size: 112px;
                    resized => { Api.layout-changed(); }
                }
                Splitter {
                    x: parent.width - parent.modified-width - Api.column-capabilities - 3px;
                    height: parent.height;
                    show-line: true;
                    reversed: true;
                    size <=> Api.column-capabilities;
                    minimum: 60px;
                    maximum: min(240px, Api.column-capabilities + max(root.room, 0px));
                    default-size: 118px;
                    resized => { Api.layout-changed(); }
                }
                Splitter {
                    x: parent.width - parent.modified-width - Api.column-capabilities - Api.column-size - 3px;
                    height: parent.height;
                    show-line: true;
                    reversed: true;
                    size <=> Api.column-size;
                    minimum: 60px;
                    maximum: min(180px, Api.column-size + max(root.room, 0px));
                    default-size: 90px;
                    resized => { Api.layout-changed(); }
                }
                if !root.compact: Splitter {
                    x: parent.width - Api.column-modified - Api.column-capabilities - Api.column-size - Api.column-quantization - 3px;
                    height: parent.height;
                    show-line: true;
                    reversed: true;
                    size <=> Api.column-quantization;
                    minimum: 70px;
                    maximum: min(200px, Api.column-quantization + max(root.room, 0px));
                    default-size: 112px;
                    resized => { Api.layout-changed(); }
                }
                Splitter {
                    x: parent.width - parent.modified-width - Api.column-capabilities - Api.column-size - parent.quantization-width - Api.column-parameters - 3px;
                    height: parent.height;
                    show-line: true;
                    reversed: true;
                    size <=> Api.column-parameters;
                    minimum: 60px;
                    maximum: min(200px, Api.column-parameters + max(root.room, 0px));
                    default-size: 92px;
                    resized => { Api.layout-changed(); }
                }
            }
            Divider { }
            ListView {
                // Keyboard moves and "Show in Models" keep the selected row in view (rows are 32 px).
                property <int> selected-index: Api.selected-index;
                changed selected-index => {
                    if self.selected-index < 0 {
                        return;
                    }
                    if self.selected-index * 32px < -self.content-y {
                        self.content-y = -self.selected-index * 32px;
                    } else if (self.selected-index + 1) * 32px > -self.content-y + self.visible-height {
                        self.content-y = self.visible-height - (self.selected-index + 1) * 32px;
                    }
                }
                for row[index] in Api.models: ModelTableRow {
                    data: row;
                    index: index;
                    compact: root.compact;
                    clicked(extend, toggle) => {
                        keys.focus();
                        Api.click-model(row.name, extend, toggle);
                    }
                }
            }
        }
    }
}

// Inspector when several models are selected, like version 1: count, size, actions.
component SelectionPane inherits Rectangle {
    background: Theme.window;
    EmptyState {
        icon: Icons.models;
        title: Api.selection-title;
        message: Api.selection-summary;
        VerticalLayout {
            spacing: 8px;
            padding-top: 4px;
            if Api.selection-can-update || Api.selection-has-running: HorizontalLayout {
                alignment: center;
                spacing: 8px;
                if Api.selection-can-update: Button {
                    text: Api.selection-update-label;
                    icon: Icons.downloads;
                    colorize-icon: true;
                    clicked => { Api.update-selection(); }
                }
                if Api.selection-has-running: Button {
                    text: @tr("Unload");
                    icon: Icons.stop;
                    colorize-icon: true;
                    clicked => { Api.unload-selection(); }
                }
            }
            HorizontalLayout {
                alignment: center;
                DangerButton {
                    text: Api.selection-delete-label;
                    clicked => { Api.delete-selection(); }
                }
            }
        }
    }
}

// Right-hand pane with the details of the selected model.
component DetailsPane inherits Rectangle {
    background: Theme.window;
    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                ModelIcon {
                    kind: Api.detail.kind;
                    size: 44px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Api.detail.name;
                        font-size: Theme.font-size + 4px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    if Api.detail.summary != "": Label {
                        text: Api.detail.summary;
                        secondary: true;
                    }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if Api.detail.is-cloud: Badge { text: @tr("Cloud"); tint: Theme.capability-color("cloud"); }
                if Api.detail.running: Badge { text: @tr("In Memory"); tint: Theme.green; }
                if Api.detail.update == 2: Badge { text: @tr("Update Available"); tint: Theme.accent; }
                if Api.detail.update == 3: Badge { text: @tr("Up to Date"); }
                for capability in Api.detail.capabilities: CapabilityBadge { capability: capability; }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: @tr("Chat");
                    icon: Icons.chat;
                    colorize-icon: true;
                    enabled: Api.detail.can-chat;
                    clicked => { Api.chat-with(Api.detail.name); }
                }
                if Api.detail.running: Button {
                    text: @tr("Unload");
                    icon: Icons.stop;
                    colorize-icon: true;
                    enabled: !Api.detail.busy;
                    clicked => { Api.unload-model(Api.detail.name); }
                }
                if !Api.detail.running && Api.detail.can-load: Button {
                    text: @tr("Load");
                    icon: Icons.play;
                    colorize-icon: true;
                    enabled: !Api.detail.busy;
                    clicked => { Api.load-model(Api.detail.name); }
                    Tooltip { text: @markdown("\{Api.detail.load-tooltip}"); }
                }
                if Api.detail.downloading: ProgressIndicator {
                    width: 70px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    indeterminate: Api.detail.progress < 0;
                    progress: max(Api.detail.progress, 0);
                }
                if !Api.detail.downloading && Api.detail.update == 2: Button {
                    text: @tr("Update");
                    icon: Icons.downloads;
                    colorize-icon: true;
                    primary: true;
                    clicked => { Api.update-model(Api.detail.name); }
                }
                if Api.detail.busy: Spinner {
                    width: 16px;
                    height: 16px;
                    indeterminate: true;
                    y: (parent.height - self.height) / 2;
                }
                MenuButton {
                    icon: Icons.more;
                    label: @tr("More");
                    MenuEntry {
                        text: @tr("Update");
                        activated => { Api.update-model(Api.detail.name); }
                    }
                    MenuEntry {
                        text: @tr("Duplicate…");
                        activated => { Api.open-dialog(2, Api.detail.name); }
                    }
                    MenuEntry {
                        text: @tr("Rename…");
                        activated => { Api.open-dialog(3, Api.detail.name); }
                    }
                    MenuEntry {
                        text: @tr("Customize…");
                        enabled: Api.detail.can-customize;
                        activated => { Api.open-dialog(4, Api.detail.name); }
                    }
                    MenuEntry {
                        text: @tr("Copy Name");
                        activated => { Api.copy-name(Api.detail.name); }
                    }
                    MenuEntry {
                        text: @tr("Open Model Page");
                        enabled: Api.detail.has-page;
                        activated => { Api.open-page(Api.detail.name); }
                    }
                    MenuEntry {
                        text: @tr("Delete…");
                        text-color: Theme.red;
                        activated => { Api.open-dialog(5, Api.detail.name); }
                    }
                }
            }
            Divider { }
            for fact in Api.detail.facts: HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 118px;
                    text: fact.title;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size;
                    overflow: elide;
                }
                Text {
                    text: fact.value;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    font-family: fact.mono ? (Theme.is-macos ? "Menlo" : "Consolas") : "";
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            if Api.detail.digest != "": HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 118px;
                    text: @tr("Digest");
                    color: Theme.text-secondary;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                }
                Text {
                    text: Api.detail.short-digest;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    font-family: Theme.is-macos ? "Menlo" : "Consolas";
                    vertical-alignment: center;
                }
                ToolButton {
                    icon: Icons.copy;
                    icon-size: 13px;
                    tooltip: @tr("Copy");
                    clicked => { Api.copy-text(Api.detail.digest); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if Api.detail.loading: HorizontalLayout {
                alignment: center;
                Spinner {
                    width: 20px;
                    height: 20px;
                    indeterminate: true;
                }
            }
            if Api.detail.error != "": Label {
                text: Api.detail.error;
                secondary: true;
                wrap: word-wrap;
            }
            for section in Api.detail.sections: CodeDisclosure {
                title: section.title;
                text: section.text;
                expanded: section.expanded;
            }
        }
    }
}

export component ModelsPage inherits VerticalLayout {
    in-out property <bool> show-inspector: true;
    Toolbar {
        title: @tr("Models");
        subtitle: Api.models-subtitle;
        MenuButton {
            icon: Icons.filter;
            label: ModelFilters.title(Api.model-filter);
            y: (parent.height - self.height) / 2;
            for filter in [0, 1, 2, 3, 4, 5, 6, 7]: MenuEntry {
                text: ModelFilters.title(filter);
                checked: Api.model-filter == filter;
                activated => {
                    Api.model-filter = filter;
                    Api.models-query-changed();
                }
            }
        }
        if Api.update-count > 0: ToolButton {
            icon: Icons.downloads;
            tooltip: @tr("Update all outdated models");
            y: (parent.height - self.height) / 2;
            clicked => { Api.update-all(); }
        }
        ToolButton {
            icon: Icons.sync;
            tooltip: @tr("Check the Ollama registry for newer versions of your models");
            enabled: Api.connection == 1 && !Api.checking-updates;
            y: (parent.height - self.height) / 2;
            clicked => { Api.check-updates(); }
        }
        ToolButton {
            icon: Icons.plus;
            tooltip: @tr("Pull a model from the Ollama library");
            enabled: Api.connection == 1;
            y: (parent.height - self.height) / 2;
            clicked => { Api.open-dialog(1, ""); }
        }
        ToolButton {
            icon: Icons.info;
            tooltip: @tr("Show or hide model details");
            active: root.show-inspector;
            y: (parent.height - self.height) / 2;
            clicked => { root.show-inspector = !root.show-inspector; }
        }
        SearchField {
            width: 220px;
            y: (parent.height - self.height) / 2;
            placeholder: @tr("Filter models");
            text <=> Api.model-search;
            edited => { Api.models-query-changed(); }
        }
    }
    Divider { }
    // Hidden in a narrow window, where the table would be too narrow to read; narrower than
    // its saved width when the table would get less than 520 px.
    property <bool> inspector-visible: root.show-inspector && root.width >= 880px;
    property <length> inspector-width: min(Api.inspector-width, root.width - 520px);
    Rectangle {
        vertical-stretch: 1;
    HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;
            if Api.connection == 1 && !Api.models-loaded: Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                indeterminate: true;
            }
            if Api.connection != 1 && Api.models-count == 0: EmptyState {
                icon: Api.connection == 2 ? Icons.offline : Icons.server;
                title: Api.connection == 2 ? @tr("Ollama Is Not Reachable") : @tr("Connecting…");
                message: Api.connection == 2 ? Api.connection-error : Api.server-url;
            }
            if Api.connection == 1 && Api.models-loaded && Api.models-count == 0: EmptyState {
                icon: Icons.models;
                title: @tr("No Models Yet");
                message: @tr("Pull a model from the Ollama library to get started.");
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Button {
                        text: @tr("Pull a Model…");
                        primary: true;
                        clicked => { Api.open-dialog(1, ""); }
                    }
                    Button {
                        text: @tr("Discover Models");
                        clicked => { Api.section = 3; }
                    }
                }
            }
            if Api.models-count > 0 && Api.models.length == 0: EmptyState {
                icon: Icons.search;
                title: @tr("No Results");
            }
            if Api.models.length > 0: ModelTable {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
            }
        }
        if root.inspector-visible: VDivider { }
        if root.inspector-visible: Rectangle {
            width: root.inspector-width;
            if Api.selected-count > 1: SelectionPane { }
            if Api.selected-count <= 1 && Api.has-detail: DetailsPane { }
            if Api.selected-count <= 1 && !Api.has-detail: EmptyState {
                icon: Icons.info;
                title: @tr("No Selection");
                message: @tr("Select a model to see its details.");
            }
        }
    }
    if root.inspector-visible: Splitter {
        x: parent.width - root.inspector-width - 4px;
        height: parent.height;
        reversed: true;
        size <=> Api.inspector-width;
        minimum: 300px;
        maximum: min(560px, root.width - 520px);
        default-size: 360px;
        resized => { Api.layout-changed(); }
    }
    }
}

import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Api } from "api.slint";

export component Icon inherits Image {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    source: icon;
    colorize: tint;
    width: size;
    height: size;
    image-fit: contain;
}

export component Label inherits Text {
    in property <bool> secondary;
    in property <bool> small;
    in property <bool> strong;
    color: secondary ? Theme.text-secondary : Theme.text;
    font-size: small ? Theme.small-font-size : Theme.font-size;
    font-weight: strong ? 600 : 400;
    vertical-alignment: center;
    overflow: elide;
}

// Rounded square with the model kind's color and glyph.
export component ModelIcon inherits Rectangle {
    in property <int> kind;
    in property <length> size: 20px;
    width: size;
    height: size;
    border-radius: size * 0.27;
    background: @linear-gradient(135deg, Theme.kind-color(kind).brighter(0.25) 0%, Theme.kind-color(kind) 100%);
    Icon {
        icon: Icons.kind(kind);
        tint: white;
        size: root.size * 0.55;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text-secondary;
    height: label.preferred-height + 4px;
    width: label.preferred-width + 12px;
    border-radius: self.height / 2;
    background: tint.with-alpha(Theme.dark ? 0.24 : 0.13);
    label := Text {
        text: root.text;
        color: Theme.dark ? tint.brighter(0.3) : tint.darker(0.1);
        font-size: Theme.small-font-size - 0.5px;
        font-weight: 600;
    }
}

// Capability names shown in the user's language.
export global CapabilityText {
    public pure function title(capability: string) -> string {
        if capability == "completion" { return @tr("Text"); }
        if capability == "vision" { return @tr("Vision"); }
        if capability == "tools" { return @tr("Tools"); }
        if capability == "thinking" { return @tr("Thinking"); }
        if capability == "embedding" { return @tr("Embedding"); }
        if capability == "image" { return @tr("Image"); }
        if capability == "audio" { return @tr("Audio"); }
        if capability == "insert" { return @tr("Insert"); }
        if capability == "cloud" { return @tr("Cloud"); }
        return capability;
    }
}

export component CapabilityBadge inherits Badge {
    in property <string> capability;
    text: CapabilityText.title(capability);
    tint: Theme.capability-color(capability);
}

// Compact capability symbols for table cells, with the name as tooltip.
export component CapabilityIcons inherits HorizontalLayout {
    in property <[string]> capabilities;
    spacing: 5px;
    alignment: start;
    for capability in capabilities: Rectangle {
        width: capability == "completion" ? 0 : 15px;
        visible: capability != "completion";
        Icon {
            icon: Icons.capability(capability);
            tint: Theme.capability-color(capability);
            size: 14px;
        }
        Tooltip { text: @markdown("\{CapabilityText.title(capability)}"); }
    }
}

export component StatusDot inherits Rectangle {
    in property <color> dot-color;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: dot-color;
    drop-shadow-color: dot-color.with-alpha(0.5);
    drop-shadow-blur: 3px;
}

// Flat icon button used in toolbars.
export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <length> icon-size: 16px;
    callback clicked();
    width: 30px;
    height: 28px;
    border-radius: Theme.control-radius;
    background: !enabled ? transparent : touch.pressed ? Theme.pressed : (touch.has-hover || active) ? Theme.hover : transparent;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip { text: @markdown("\{root.tooltip}"); }
    Icon {
        icon: root.icon;
        size: root.icon-size;
        tint: root.enabled ? (root.active ? Theme.accent : Theme.text) : Theme.text-tertiary;
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(text: string);
    callback accepted(text: string);
    height: 28px;
    border-radius: Theme.control-radius + 2px;
    background: Theme.dark ? #ffffff14 : #0000000d;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;
        Icon {
            icon: Icons.search;
            tint: Theme.text-secondary;
            size: 14px;
            y: (parent.height - self.height) / 2;
        }
        input := TextInput {
            text <=> root.text;
            font-size: Theme.font-size;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            Text {
                visible: input.text == "" && !input.has-focus;
                text: root.placeholder;
                color: Theme.text-tertiary;
                font-size: Theme.font-size;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }
        }
        if root.text != "": ToolButton {
            icon: Icons.close;
            icon-size: 12px;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}

// Centered placeholder with icon, title and message.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> message;
    alignment: center;
    spacing: 8px;
    padding: 24px;
    HorizontalLayout {
        alignment: center;
        Icon {
            icon: root.icon;
            size: 40px;
            tint: Theme.text-tertiary;
        }
    }
    Text {
        text: root.title;
        font-size: Theme.font-size + 4px;
        font-weight: 600;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.message != "": Text {
        text: root.message;
        font-size: Theme.font-size;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    @children
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius + 2px;
    border-width: 1px;
    border-color: Theme.card-stroke;
}

// Monospaced, selectable text with a copy button.
export component CodeBlock inherits Rectangle {
    in property <string> text;
    in property <length> limit: 240px;
    background: Theme.code;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    height: min(content.preferred-height + 16px, limit);
    ScrollView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        content-height: content.preferred-height + 16px;
        // No scroll bar when everything fits.
        vertical-scrollbar-policy: content.preferred-height + 16px > root.limit ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        content := TextInput {
            x: 10px;
            y: 8px;
            width: parent.width - 44px;
            text: root.text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            font-family: Theme.is-macos ? "Menlo" : "Consolas";
            font-size: Theme.small-font-size;
            color: Theme.text;
        }
    }
    ToolButton {
        x: parent.width - self.width - 4px;
        y: 4px;
        icon: Icons.copy;
        icon-size: 13px;
        tooltip: @tr("Copy");
        clicked => { Api.copy-text(root.text); }
    }
}

// Section with a clickable header that shows or hides a block of text.
export component CodeDisclosure inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in-out property <bool> expanded;
    spacing: 6px;
    header := Rectangle {
        height: 26px;
        HorizontalLayout {
            spacing: 6px;
            Icon {
                icon: root.expanded ? Icons.chevron-down : Icons.chevron-right;
                size: 13px;
                tint: Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }
            Label {
                text: root.title;
                strong: true;
            }
        }
        TouchArea {
            clicked => { root.expanded = !root.expanded; }
        }
    }
    if root.expanded: CodeBlock {
        text: root.text;
        limit: 300px;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.divider;
}

// Title and subtitle shown at the top-left of every page.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    alignment: center;
    spacing: 1px;
    Text {
        text: root.title;
        font-size: Theme.title-font-size;
        font-weight: 700;
        color: Theme.text;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: Theme.small-font-size;
        color: Theme.text-secondary;
        overflow: elide;
    }
}

// A simple pull-down menu button: shows `label` and a chevron, opens `@children` in a popup.
export component MenuButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    callback opened();
    height: 28px;
    width: row.preferred-width + 16px;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.field-stroke;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.field;
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        if root.icon.width > 0: Icon {
            icon: root.icon;
            size: 14px;
            tint: root.enabled ? Theme.text : Theme.text-tertiary;
            y: (parent.height - self.height) / 2;
        }
        Label {
            text: root.label;
            color: root.enabled ? Theme.text : Theme.text-tertiary;
        }
        Icon {
            icon: Icons.chevron-down;
            size: 12px;
            tint: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.opened();
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-stroke;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            VerticalLayout {
                padding: 4px;
                @children
            }
        }
    }
}

// An entry of a MenuButton popup.
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <color> text-color: Theme.text;
    callback activated();
    height: 26px;
    min-width: 180px;
    // Long names (servers, models) are elided instead of widening the menu.
    max-width: 420px;
    border-radius: Theme.control-radius - 2px;
    background: touch.has-hover && enabled ? Theme.accent : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 6px;
        Rectangle {
            width: 14px;
            if root.checked: Icon {
                icon: Icons.check;
                size: 13px;
                tint: touch.has-hover ? Theme.on-accent : Theme.text;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-size;
            color: !root.enabled ? Theme.text-tertiary : touch.has-hover ? Theme.on-accent : root.text-color;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

// Top bar of a page: title on the left, actions on the right. Empty areas move the
// window, since the macOS title bar is merged with the content.
export component Toolbar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: Theme.toolbar-height;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 6px;
        PageTitle {
            title: root.title;
            subtitle: root.subtitle;
            horizontal-stretch: 1;
        }
        @children
    }
}

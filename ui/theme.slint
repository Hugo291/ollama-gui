import { Palette } from "std-widgets.slint";

// Colors and metrics. The macOS look follows the Swift version of the app;
// on Windows the same layout uses Fluent colors.
export global Theme {
    // Set from Rust at startup.
    in property <bool> is-macos: true;

    // Palette.color-scheme follows the system until the app forces light or dark. After
    // going back to "System" it is `unknown`, and Rust tells whether the system is dark.
    in property <bool> system-dark;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark || (Palette.color-scheme == ColorScheme.unknown && system-dark);

    out property <color> accent: is-macos ? (dark ? #0a84ff : #007aff) : (dark ? #4cc2ff : #0067c0);
    out property <color> on-accent: is-macos ? #ffffff : (dark ? #000000 : #ffffff);

    out property <color> window: dark ? #1e1e1e : #ffffff;
    out property <color> sidebar: is-macos ? (dark ? #29292b : #eeeef0) : (dark ? #202020 : #f3f3f3);
    out property <color> surface: dark ? #262628 : #f7f7f9;
    out property <color> card: dark ? #2a2a2c : #ffffff;
    out property <color> card-stroke: dark ? #3a3a3c : #e3e3e6;
    out property <color> divider: dark ? #3a3a3c : #e1e1e4;
    out property <color> hover: dark ? #ffffff14 : #0000000a;
    out property <color> pressed: dark ? #ffffff1f : #00000014;
    out property <color> zebra: dark ? #ffffff08 : #00000006;
    out property <color> selection: dark ? #0a84ff40 : #007aff26;
    out property <color> sidebar-selection: is-macos ? (dark ? #ffffff1f : #00000014) : (dark ? #ffffff14 : #0000000f);
    out property <color> field: dark ? #ffffff12 : #ffffff;
    out property <color> field-stroke: dark ? #ffffff26 : #c9c9ce;
    out property <color> code: dark ? #ffffff0d : #00000008;
    out property <color> overlay: dark ? #00000099 : #0000004d;

    out property <color> text: dark ? #f5f5f7 : #1d1d1f;
    // Contrast (WCAG AA): secondary text ≥ 4.5:1 on every background, tertiary is for
    // placeholders and disabled controls.
    out property <color> text-secondary: dark ? #a1a1a6 : #616165;
    out property <color> text-tertiary: dark ? #8e8e93 : #86868b;

    // Darker in the light theme, where they are also used for text on white.
    out property <color> green: dark ? #30d158 : #1e7b34;
    out property <color> orange: dark ? #ff9f0a : #b35c00;
    out property <color> red: dark ? #ff453a : #c5221f;
    out property <color> blue: dark ? #0a84ff : #007aff;

    out property <length> font-size: is-macos ? 13px : 14px;
    out property <length> small-font-size: is-macos ? 11px : 12px;
    out property <length> title-font-size: is-macos ? 15px : 20px;
    out property <length> radius: is-macos ? 8px : 6px;
    out property <length> control-radius: is-macos ? 6px : 4px;
    out property <length> toolbar-height: 52px;
    // Space for the traffic lights over the sidebar (macOS unified title bar).
    out property <length> titlebar-inset: is-macos ? 40px : 8px;

    // Kinds of models: text, vision, embedding, image, cloud.
    public pure function kind-color(kind: int) -> color {
        if kind == 1 { return dark ? #bf5af2 : #af52de; }
        if kind == 2 { return dark ? #ff9f0a : #ff9500; }
        if kind == 3 { return dark ? #ff375f : #ff2d55; }
        if kind == 4 { return dark ? #40c8e0 : #30b0c7; }
        return dark ? #0a84ff : #007aff;
    }

    public pure function capability-color(capability: string) -> color {
        if capability == "completion" { return blue; }
        if capability == "vision" { return dark ? #bf5af2 : #af52de; }
        if capability == "tools" { return dark ? #ff9f0a : #e8850c; }
        if capability == "thinking" { return dark ? #ff375f : #d63384; }
        if capability == "embedding" { return dark ? #ac8e68 : #a2845e; }
        if capability == "image" { return dark ? #5e5ce6 : #5856d6; }
        if capability == "audio" { return green; }
        if capability == "cloud" { return dark ? #40c8e0 : #1f9fb5; }
        return text-secondary;
    }
}

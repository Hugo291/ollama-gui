msgid "This isn't a valid model name."
msgstr "Ce nom de modèle n’est pas valide."

#: ui/dialogs.slint:67
msgid "Already installed: pulling it again updates it to the latest version."
msgstr "Déjà installé : le télécharger à nouveau le met à jour vers la dernière version."

#: ui/dialogs.slint:68
msgid "Examples: gemma3, qwen3:8b, hf.co/unsloth/Qwen3-8B-GGUF:Q4_K_M"
msgstr "Exemples : gemma3, qwen3:8b, hf.co/unsloth/Qwen3-8B-GGUF:Q4_K_M"

